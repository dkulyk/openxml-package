{
    "name": "dkulyk/openxml-package",
    "description": "Read, write, encrypt, and decrypt OPC packages for Office Open XML documents",
    "keywords": [
        "docx",
        "encryption",
        "office-open-xml",
        "openxml",
        "opc",
        "pptx",
        "xlsx"
    ],
    "homepage": "https://github.com/dkulyk/openxml-package",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-dom": "*",
        "ext-zip": "*"
    },
    "require-dev": {
        "dkulyk/compound-file": "^0.2.0",
        "friendsofphp/php-cs-fixer": "^3.88",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.5"
    },
    "replace": {
        "dkulyk/openxml": "self.version"
    },
    "autoload": {
        "psr-4": {
            "DK\\OpenXml\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DK\\OpenXml\\Tests\\": "tests/"
        }
    },
    "support": {
        "issues": "https://github.com/dkulyk/openxml-package/issues",
        "source": "https://github.com/dkulyk/openxml-package"
    },
    "suggest": {
        "dkulyk/compound-file": "Required to inspect, encrypt, and decrypt CFBF-based Office Open XML files.",
        "ext-openssl": "Required to encrypt and decrypt Office Open XML files."
    },
    "scripts": {
        "test": "phpunit",
        "benchmark": "php tools/benchmark.php",
        "benchmark-removal": "php tools/benchmark-removal.php",
        "benchmark-staged-streams": "php tools/benchmark-staged-streams.php",
        "lint": "php tools/lint.php",
        "analyse": "phpstan analyse --no-progress --debug --memory-limit=512M",
        "format": "php-cs-fixer fix --sequential --allow-unsupported-php-version=yes --verbose",
        "check-style": "php-cs-fixer fix --sequential --allow-unsupported-php-version=yes --dry-run --diff --verbose",
        "check": [
            "@validate-composer",
            "@lint",
            "@check-style",
            "@analyse",
            "@test"
        ],
        "validate-composer": "composer validate --strict"
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    }
}
